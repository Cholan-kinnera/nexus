# Database configuration
# For local dev: postgresql+asyncpg://<user>:<password>@localhost:5432/<db_name>
# For docker dev: postgresql+asyncpg://postgres:nexus_secure_password@db:5432/nexus_pm
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/nexus_pm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=nexus_secure_password
POSTGRES_DB=nexus_pm

# Security & JWT Token Configs
SECRET_KEY=generate_a_secure_random_key_here
REFRESH_SECRET_KEY=generate_another_secure_random_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# API Server Host/Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# AWS (Simple Email Service / General AWS SDK Configs)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
SES_SENDER_EMAIL=your_verified_sender_email@domain.com

# Google Authentication Client IDs
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Cloudflare R2 / S3 Object Storage Configurations
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here
R2_PUBLIC_URL=https://pub-your_r2_bucket_subdomain.r2.dev
