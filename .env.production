# Production Environment Configurations - DO NOT COMMIT SENSITIVE SECRETS
# Replace these with real credentials inside your secure hosting provider (Railway, Vercel, etc.)

DATABASE_URL=postgresql+asyncpg://postgres:nexus_secure_password@db:5432/nexus_pm

# IMPORTANT: Generate secure random keys in production
SECRET_KEY=generate_a_long_random_hash_key_for_jwt_session
REFRESH_SECRET_KEY=generate_a_second_long_random_hash_key_for_jwt_session
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=true
COOKIE_SAMESITE=none

REDIS_URL=redis://redis:6379/0

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# AWS Credentials (SES Email Services)
AWS_ACCESS_KEY_ID=your_production_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_production_aws_secret_access_key
AWS_REGION=us-east-1
SES_SENDER_EMAIL=noreply@yourproductiondomain.com

# Google OAuth Production Credentials
GOOGLE_CLIENT_ID=your_production_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_production_google_client_secret

# Cloudflare R2 Production Bucket Configurations
R2_ACCOUNT_ID=your_production_r2_account_id
R2_ACCESS_KEY_ID=your_production_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_production_r2_secret_access_key
R2_BUCKET_NAME=nexus-pm-prod
R2_PUBLIC_URL=https://assets.yourproductiondomain.com
